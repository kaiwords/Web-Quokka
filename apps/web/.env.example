# Public form endpoints on the management app (apps/management), no trailing
# slash. Forms POST to `${VITE_API_BASE_URL}/contact`, `/quote` and
# `/newsletter`. The management app must list this site's origin in its own
# PUBLIC_SITE_ORIGINS variable, or the browser will block the request.
VITE_API_BASE_URL=https://app.webquokka.com.au/api/public

# Origin of the management app, used to link to the client portal and the
# staff CRM (no trailing slash). The marketing site never holds a session
# itself — it only links across, so auth cookies stay same-origin there.
VITE_MANAGEMENT_URL=https://app.webquokka.com.au
