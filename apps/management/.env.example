# WebQuokka management app (staff CRM + client portal) — environment variables.
# Copy to .env and fill in. NEVER commit .env.

# ---- Database: Supabase Postgres ----
# Both come from the Supabase dashboard: Project Settings -> Database ->
# Connection string. Two different URLs are required and they are NOT
# interchangeable:
#
#   DATABASE_URL  Connection pooling / "Transaction" mode, port 6543. What the
#                 app queries through. `pgbouncer=true` tells Prisma not to use
#                 prepared statements, which transaction pooling cannot support.
#   DIRECT_URL    The direct connection, port 5432. Prisma migrations need a
#                 real session, so they cannot run over the pooler.
#
# Remember to URL-encode any special characters in the password (@ -> %40).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Supabase project (only needed for Storage / the JS client) ----
# The app's auth is its own (scrypt + database sessions, see src/lib/auth.ts and
# src/lib/portalAuth.ts) and does NOT use Supabase Auth, so no anon key is
# required to run it. These are here for Supabase Storage or dashboard tooling.
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---- App config ----
# Public origin of THIS app. Used to build the links in invite, password-reset
# and email-confirmation emails, so a wrong value sends users to a dead link.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Origins allowed to POST to /api/public/* (the marketing site's contact, quote
# and newsletter forms). Comma-separated, exact origins, no trailing slash.
# localhost Vite ports are allowed automatically outside production.
PUBLIC_SITE_ORIGINS="https://webquokka.com.au,https://www.webquokka.com.au"

# ---- Email (optional) ----
# Invite, password-reset and email-confirmation messages log to the server
# console until RESEND_API_KEY is set (see src/lib/mailer.ts). Self-signup
# depends on email to confirm an address, so set this before going live or new
# clients cannot activate their accounts.
# RESEND_API_KEY="re_..."
# MAIL_FROM="WebQuokka <noreply@webquokka.com.au>"

# Where new website enquiries are emailed. Unset means in-app notifications
# only (the bell in the staff top bar), which always works.
# ENQUIRY_NOTIFY_EMAIL="quokkasupport@gmail.com"

# ---- Invoice PDFs ----
# WebQuokka's ABN, printed on every tax invoice PDF. An Australian tax invoice
# must show the seller's ABN — PDFs say "Not yet provided" until this is set.
# WEBQUOKKA_ABN="12 345 678 901"
